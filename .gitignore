# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
dist-ssr/
build/
*.local

# vite / tooling cache
.vite/
.cache/
*.tsbuildinfo

# env — never commit these
.env
.env.local
.env.*.local
!.env.example

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# NOTE: data/ and public/model/ are intentionally TRACKED.
# Captured training JSON and the trained model are project deliverables —
# committing them is how Mert and Aaron merge datasets and how the deploy
# gets a model. Do not add them here.

# scratch — raw video/screen captures used while recording, not deliverables
data/raw/
*.webm
*.mov

# Phase 2 harness scratch — synthetic captures and a stand-in model.
# NEVER let a stand-in model reach public/model/: createRecognizer loads that
# path, and a fake classifier there makes the app commit wrong letters with no
# warning, which is worse than having no model at all.
.phase2/
